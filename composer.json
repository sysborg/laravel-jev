{
    "name": "sysborg/laravel-jevai",
    "description": "Laravel package to integrate with Jev AI",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "jev",
        "jev-ai",
        "ai",
        "llm",
        "decision-api",
        "observability"
    ],
    "homepage": "https://github.com/sysborg/laravel-jev",
    "support": {
        "issues": "https://github.com/sysborg/laravel-jev/issues",
        "source": "https://github.com/sysborg/laravel-jev"
    },
    "authors": [
        {
            "name": "Anderson Arruda",
            "email": "andmarruda@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "guzzlehttp/promises": "^2.0.4 || ^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/pulse": "^1.4.1",
        "open-telemetry/api": "^1.8",
        "open-telemetry/sdk": "^1.13",
        "open-telemetry/sem-conv": "^1.38",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "symfony/polyfill-intl-grapheme": "^1.31",
        "symfony/polyfill-intl-idn": "^1.31",
        "symfony/polyfill-intl-normalizer": "^1.31",
        "symfony/polyfill-mbstring": "^1.31",
        "symfony/polyfill-php83": "^1.31",
        "symfony/polyfill-php84": "^1.31"
    },
    "suggest": {
        "laravel/pulse": "Required to use the Jev usage Pulse recorder and card",
        "open-telemetry/api": "Required to use the OpenTelemetry tracer and metrics adapters"
    },
    "autoload": {
        "psr-4": {
            "Sysborg\\LaravelJevai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sysborg\\LaravelJevai\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/Fakes.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sysborg\\LaravelJevai\\JevServiceProvider"
            ],
            "aliases": {
                "Jev": "Sysborg\\LaravelJevai\\Facades\\Jev",
                "JevUsage": "Sysborg\\LaravelJevai\\Facades\\JevUsage"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --configuration=phpunit.coverage.xml.dist --coverage --min=90",
        "test:mutate": "pest --configuration=phpunit.coverage.xml.dist --mutate --everything --covered-only --path=src/Domain --min=80",
        "test:live": "pest --testsuite=Live",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
