{
    "name": "sysborg/laravel-jevai",
    "description": "Laravel package to integrate with Jev AI",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "jev",
        "jev-ai",
        "ai",
        "llm",
        "decision-api",
        "observability"
    ],
    "homepage": "https://github.com/sysborg/laravel-jev",
    "support": {
        "issues": "https://github.com/sysborg/laravel-jev/issues",
        "source": "https://github.com/sysborg/laravel-jev"
    },
    "authors": [
        {
            "name": "Anderson Arruda",
            "email": "andmarruda@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "illuminate/bus": "^11.45 || ^12.0 || ^13.0",
        "illuminate/console": "^11.45 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.45 || ^12.0 || ^13.0",
        "illuminate/database": "^11.45 || ^12.0 || ^13.0",
        "illuminate/http": "^11.45 || ^12.0 || ^13.0",
        "illuminate/support": "^11.45 || ^12.0 || ^13.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/pulse": "^1.4",
        "open-telemetry/api": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "laravel/pulse": "Required to use the Jev usage Pulse recorder and card",
        "open-telemetry/api": "Required to use the OpenTelemetry tracer and metrics adapters"
    },
    "autoload": {
        "psr-4": {
            "Sysborg\\LaravelJevai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sysborg\\LaravelJevai\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/Fakes.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sysborg\\LaravelJevai\\JevServiceProvider"
            ],
            "aliases": {
                "Jev": "Sysborg\\LaravelJevai\\Facades\\Jev",
                "JevUsage": "Sysborg\\LaravelJevai\\Facades\\JevUsage"
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage --min=90",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
