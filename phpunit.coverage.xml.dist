<?xml version="1.0" encoding="UTF-8"?>
<!--
    Coverage and mutation gates (T-06): only the Domain and Application layers,
    which must stay above 90% line coverage (and 80% mutation score for Domain).
    Run with: composer test:coverage / composer test:mutate (needs pcov or Xdebug).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src/Domain</directory>
            <directory>src/Application</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="JEV_AI_API_KEY" value="test-key"/>
    </php>
</phpunit>
